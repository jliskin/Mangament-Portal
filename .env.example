# --- required ---
POSTGRES_PASSWORD=change-me-long-random
CP_SECRET_KEY=change-me-64-random-chars        # python -c "import secrets;print(secrets.token_urlsafe(48))"
CP_DOMAIN=localhost                             # public domain for TLS, or 'localhost' / LAN name
# --- optional ---
CP_TIMEZONE=Asia/Jerusalem                     # scheduler runs the daily job at 06:00 in this zone
CP_SESSION_COOKIE_SECURE=true
CP_MAX_UPLOAD_MB=15
CP_PRORATE_PARTIAL_MONTHS=true
CP_BANK_WEBHOOK_SECRET=                         # only if an Open-Banking aggregator pushes transactions
